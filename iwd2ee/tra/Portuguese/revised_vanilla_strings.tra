@135770=~Arma Marcial: Montante~
@135771=~Arma Marcial: Espada Grande~
@135772=~Arma Simples: Lâmina Pequena~
@135773=~Ambidestria~
@135774=~Golpe Arterial~
@135775=~Usar Armadura~
@135776=~Usar Armadura (leve)~
@135777=~Usar Armadura (média)~
